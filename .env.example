# ==============================================================================
# 🖥️ BACKEND & DISCORD BOT ENVIRONMENT VARIABLES (Host on Pterodactyl)
# ==============================================================================
# The port the Express API server will listen on inside your Pterodactyl allocation
PORT=3000

# Your Discord Application Client ID (from Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID="your_discord_client_id_here"

# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Your Discord Client Secret (from Discord Developer Portal -> OAuth2 -> Client Secret)
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# The full external URL of your Pterodactyl server (with protocol and port)
# Used as the base for Discord OAuth2 redirects
# Example: http://slu1.heavencloud.in:2492
APP_URL="http://localhost:3000"

# ==============================================================================
# 🌐 FRONTEND ENVIRONMENT VARIABLES (Host on Vercel)
# ==============================================================================
# The public API URL of your backend hosted on Pterodactyl
# Example: https://nexus-bot-backend.myhost.com or http://12.34.56.78:3000
VITE_API_URL="http://localhost:3000"

